# Copy to apps/api/.env for local development. Never commit .env.
# Loaded by `npm run dev`; in production the platform sets these.

# MongoDB connection string. Must end with the database name (/roisalen),
# otherwise the driver writes to the "test" database.
MONGO_URI=mongodb://127.0.0.1:27017/roisalen

# HTTP port
PORT=8080

# Comma-separated browser origins allowed to call the API. Required in production.
# "*" matches exactly one DNS label.
#   staging:    https://*.roisalen.pages.dev plus the staging frontend origin
#   production: https://roisalen.no
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Usage dashboard (/usage/summary). Min 8 characters; empty disables it.
ROISALEN_ADMIN_SECRET=
